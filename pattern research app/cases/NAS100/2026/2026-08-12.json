  "intraday_notes": [
    {
      "id": "note-b2275d4b2596",
      "replay_time": "2026-08-12 09:35:00 EDT",
      "text": "大K線開盤",
      "created_at": "2026-09-23T02:05:08.544750+00:00",
      "updated_at": "2026-09-23T02:05:08.544759+00:00"
    },
    {
      "id": "note-44ccbbb1c818",
      "replay_time": "2026-08-12 09:44:00 EDT",
      "text": "可以嘗試前低、昨天高點Long Limit\n沒有成交",
      "created_at": "2026-09-23T02:06:17.332051+00:00",
      "updated_at": "2026-09-23T02:06:36.552112+00:00"
    },
    {
      "id": "note-91b4a7da339d",
      "replay_time": "2026-08-12 09:54:00 EDT",
      "text": "開盤TR但TR波幅偏大0.5% 感覺會偏向震盪突破要直接拿1~1.5R有點難",
      "created_at": "2026-09-23T02:07:40.660694+00:00",
      "updated_at": "2026-09-23T05:58:59.996875+00:00"
    },
    {
      "id": "note-e92a7a7eb48d",
      "replay_time": "2026-08-12 10:09:00 EDT",
      "text": "這邊50%以下SB 用Long Limit拿Scalp",
      "created_at": "2026-09-23T02:08:36.650621+00:00",
      "updated_at": "2026-09-23T02:08:36.650630+00:00"
    },
    {
      "id": "note-845d7c1b8176",
      "replay_time": "2026-08-12 10:24:00 EDT",
      "text": "拿到1R，可以嘗試拿小前高+上1/3",
      "created_at": "2026-09-23T02:09:27.116287+00:00",
      "updated_at": "2026-09-23T02:09:27.116292+00:00"
    },
    {
      "id": "note-875497cf600a",
      "replay_time": "2026-08-12 10:31:00 EDT",
      "text": "沒拿到上1/3 小前高 Scalp BE離場",
      "created_at": "2026-09-23T02:10:14.705374+00:00",
      "updated_at": "2026-09-23T03:11:41.796730+00:00"
    },
    {
      "id": "note-2d2f98b3c2bc",
      "replay_time": "2026-08-12 11:45:00 EDT",
      "text": "等看看有沒有12點反轉目前空間有拉出來 可以等Confirm bar",
      "created_at": "2026-09-23T02:11:19.792286+00:00",
      "updated_at": "2026-09-23T03:12:46.634776+00:00"
    },
    {
      "id": "note-171f91d28e8c",
      "replay_time": "2026-08-12 12:04:00 EDT",
      "text": "micro DB 用小停損嘗試拿至少到50%",
      "created_at": "2026-09-23T02:12:37.205616+00:00",
      "updated_at": "2026-09-23T02:12:37.205628+00:00"
    },
    {
      "id": "note-d076559a3d3b",
      "replay_time": "2026-08-12 12:34:00 EDT",
      "text": "這邊看起來反轉失敗碰前高沒過，可能變成下半區震盪 BE 離場",
      "created_at": "2026-09-23T02:14:30.072685+00:00",
      "updated_at": "2026-09-23T02:14:42.298061+00:00"
    },
    {
      "id": "note-6a11bea8c12f",
      "replay_time": "2026-08-12 12:53:00 EDT",
      "text": "判斷錯誤 空方拿micro WBO first MM後就被多方反轉",
      "created_at": "2026-09-23T02:15:36.377531+00:00",
      "updated_at": "2026-09-23T02:15:36.377541+00:00"
    },
    {
      "id": "note-db71f92072f5",
      "replay_time": "2026-08-12 13:07:00 EDT",
      "text": "賭反轉的多方拿到 2R、50%",
      "created_at": "2026-09-23T02:16:28.662169+00:00",
      "updated_at": "2026-09-23T02:16:28.662178+00:00"
    },
    {
      "id": "note-6d887ab2ffc6",
      "replay_time": "2026-08-12 14:03:00 EDT",
      "text": "50%附近整理 接下來可能下半區震盪",
      "created_at": "2026-09-23T02:17:30.432389+00:00",
      "updated_at": "2026-09-23T02:17:35.864574+00:00"
    },
    {
      "id": "note-5b4ba67b6e78",
      "replay_time": "2026-08-12 14:54:00 EDT",
      "text": "還可以的SB 看有沒有Short Scalp機會",
      "created_at": "2026-09-23T02:19:25.215853+00:00",
      "updated_at": "2026-09-23T02:19:25.215860+00:00"
    },
    {
      "id": "note-4e228420b730",
      "replay_time": "2026-08-12 14:57:00 EDT",
      "text": "拿到1R位置，看有沒有突破可以拿到半區50%+2R附近",
      "created_at": "2026-09-23T02:20:14.549028+00:00",
      "updated_at": "2026-09-23T02:20:14.549034+00:00"
    },
    {
      "id": "note-cf695a89fa80",
      "replay_time": "2026-08-12 15:19:00 EDT",
      "text": "快收盤在TR下緣震盪可以離場或是看能不能拿到低點",
      "created_at": "2026-09-23T02:21:07.874539+00:00",
      "updated_at": "2026-09-23T02:21:07.874548+00:00"
    },
    {
      "id": "note-500478db2c45",
      "replay_time": "2026-08-12 15:22:00 EDT",
      "text": "拿到低點、2R 空方應該會開始離場",
      "created_at": "2026-09-23T02:21:22.155285+00:00",
      "updated_at": "2026-09-23T02:21:22.155294+00:00"
    },
    {
      "id": "note-161329eac556",
      "replay_time": "2026-08-12 15:59:00 EDT",
      "text": "最後拿到下半區低點附近比想像中來的強",
      "created_at": "2026-09-23T02:22:01.225144+00:00",
      "updated_at": "2026-09-23T02:22:01.225153+00:00"
    }
