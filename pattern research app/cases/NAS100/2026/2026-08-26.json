    },
    {
      "id": "pattern-c3c0a44cc51f",
      "text": "12點反轉",
      "created_at": "2026-09-26T14:59:10.261068+00:00",
      "updated_at": "2026-09-26T14:59:10.261083+00:00"
    },
    {
      "id": "pattern-5e7c44854650",
      "text": "開盤偏單邊",
      "created_at": "2026-09-30T04:35:49.995754+00:00",
      "updated_at": "2026-09-30T04:35:49.995754+00:00"
    }
  ],
  "intraday_notes": [
    {
      "id": "note-82a27edfa6c8",
      "replay_time": "2026-08-26 09:50:00 EDT",
      "text": "開盤震盪向上\n1. 向上突破就等12點反轉\n2. 10點向下反轉會走比較震盪的下跌 一樣等12點反轉或是Long Limit",
      "created_at": "2026-09-26T14:20:46.505655+00:00",
      "updated_at": "2026-09-26T14:20:46.505665+00:00"
    },
    {
      "id": "note-fc067d7a26b6",
      "replay_time": "2026-08-26 10:04:00 EDT",
      "text": "多方拿到1m TR BO 1R\n有可能10點反轉或TTR",
      "created_at": "2026-09-26T14:21:17.915883+00:00",
      "updated_at": "2026-09-26T14:22:04.039991+00:00"
    },
    {
      "id": "note-488a17de2525",
      "replay_time": "2026-08-26 10:09:00 EDT",
      "text": "用小SL嘗試拿2R到micro WBO second MM\n小心first MM反轉",
      "created_at": "2026-09-26T14:23:11.370930+00:00",
      "updated_at": "2026-09-26T14:23:11.370939+00:00"
    },
    {
      "id": "note-a0ca72db1461",
      "replay_time": "2026-08-26 10:21:00 EDT",
      "text": "拿到2R，等空方嘗試突破前低後的Bull SB低點Long Limit\n最好配合波幅達到",
      "created_at": "2026-09-26T14:24:28.359305+00:00",
      "updated_at": "2026-09-26T14:24:38.997236+00:00"
    },
    {
      "id": "note-4166309400e3",
      "replay_time": "2026-08-26 10:39:00 EDT",
      "text": "這邊在嘗試拿更好的位置，長下影線更低位置用大SL",
      "created_at": "2026-09-26T14:25:59.035482+00:00",
      "updated_at": "2026-09-26T14:25:59.035490+00:00"
    },
    {
      "id": "note-73b9151be58d",
      "replay_time": "2026-08-26 10:59:00 EDT",
      "text": "1. 空方拿second leg按照原定計劃\n2. 多方反向BO往上拿波幅變成在前高更上方一點Short Limit可能整天震盪",
      "created_at": "2026-09-26T14:28:14.662573+00:00",
      "updated_at": "2026-09-26T14:28:14.662581+00:00"
    },
    {
      "id": "note-945ac85e7a9e",
      "replay_time": "2026-08-26 11:34:00 EDT",
      "text": "有可能12點反轉向下但1m不太像TR要再震盪一陣子",
      "created_at": "2026-09-26T14:30:44.931662+00:00",
      "updated_at": "2026-09-26T14:30:56.206424+00:00"
    },
    {
      "id": "note-a74fb12307da",
      "replay_time": "2026-08-26 11:39:00 EDT",
      "text": "這邊前高Sell limit拿1R~2R，用大SL前高加倉",
      "created_at": "2026-09-26T14:32:05.640071+00:00",
      "updated_at": "2026-09-26T14:32:05.640082+00:00"
    },
    {
      "id": "note-eeeedd111a9d",
      "replay_time": "2026-08-26 12:04:00 EDT",
      "text": "12點反轉 拿到1R 出1/2 剩下一半前低出\n有空方TP留長下影線\n這邊小心進入全天震盪",
      "created_at": "2026-09-26T14:34:23.239113+00:00",
      "updated_at": "2026-09-26T14:34:23.239120+00:00"
    },
    {
      "id": "note-525879ddd301",
      "replay_time": "2026-08-26 12:56:00 EDT",
      "text": "1m Bull TTR BO離場有可能半區已經出來",
      "created_at": "2026-09-26T14:35:35.488581+00:00",
      "updated_at": "2026-09-26T14:35:35.488589+00:00"
    },
    {
      "id": "note-677642836258",
      "replay_time": "2026-08-26 13:11:00 EDT",
      "text": "一樣前高Sell limit",
      "created_at": "2026-09-26T14:36:41.011068+00:00",
      "updated_at": "2026-09-26T14:36:41.011076+00:00"
    },
    {
      "id": "note-f1b10ee8337c",
      "replay_time": "2026-08-26 13:41:00 EDT",
      "text": "第一倉成交，今天高點加倉",
      "created_at": "2026-09-26T14:37:42.910829+00:00",
      "updated_at": "2026-09-26T14:37:42.910839+00:00"
    },
    {
      "id": "note-d095785fd06f",
      "replay_time": "2026-08-26 14:06:00 EDT",
      "text": "這個倉位嘗試拿50%因為快收盤、多方偏強還沒有second leg",
      "created_at": "2026-09-26T14:38:27.836340+00:00",
      "updated_at": "2026-09-26T14:38:27.836347+00:00"
    },
    {
      "id": "note-72f08a948bf1",
      "replay_time": "2026-08-26 14:57:00 EDT",
      "text": "多方TTR BO拿到second leg 1R\n一樣前高加倉，這邊嘗試第一倉打平位置離場",
      "created_at": "2026-09-26T14:39:48.013016+00:00",
      "updated_at": "2026-09-26T14:39:48.013024+00:00"
    },
    {
      "id": "note-9c923f24b265",
      "replay_time": "2026-08-26 15:59:00 EDT",
      "text": "收盤剛好在第一倉位置 離場",
      "created_at": "2026-09-26T14:41:55.615342+00:00",
      "updated_at": "2026-09-26T14:41:55.615349+00:00"
    }
  ],
