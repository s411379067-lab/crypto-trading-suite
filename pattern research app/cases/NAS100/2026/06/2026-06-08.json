  "intraday_notes": [
    {
      "id": "note-0bf8314b060b",
      "replay_time": "2026-06-08 09:44:00 EDT",
      "text": "超大K線開盤 開盤偏單邊轉為開盤TR\n波幅超過50%全天波幅用Limit order",
      "created_at": "2026-09-30T08:19:08.279780+00:00",
      "updated_at": "2026-09-30T08:19:34.975787+00:00"
    },
    {
      "id": "note-2260fe9cfd19",
      "replay_time": "2026-06-08 09:59:00 EDT",
      "text": "實體Bear bar BO，嘗試BE",
      "created_at": "2026-09-30T08:20:35.425885+00:00",
      "updated_at": "2026-09-30T08:20:35.425894+00:00"
    },
    {
      "id": "note-470af49e5b30",
      "replay_time": "2026-06-08 10:04:00 EDT",
      "text": "可能偏向震盪空方",
      "created_at": "2026-09-30T08:21:00.436136+00:00",
      "updated_at": "2026-09-30T08:21:00.436147+00:00"
    },
    {
      "id": "note-a51bb02322ca",
      "replay_time": "2026-06-08 10:09:00 EDT",
      "text": "這邊10點反轉SB太大沒辦法拿到1R\n選擇前低Buy limit",
      "created_at": "2026-09-30T08:21:41.724634+00:00",
      "updated_at": "2026-09-30T08:21:41.724641+00:00"
    },
    {
      "id": "note-c3fe8c0aafa2",
      "replay_time": "2026-06-08 10:29:00 EDT",
      "text": "多方second leg看會不會前高附近TTR 等BO",
      "created_at": "2026-09-30T08:22:14.164792+00:00",
      "updated_at": "2026-09-30T08:22:14.164802+00:00"
    },
    {
      "id": "note-35d165d18f12",
      "replay_time": "2026-06-08 10:49:00 EDT",
      "text": "這裡有可能上去拿波幅 但是空間有限除非大波動日",
      "created_at": "2026-09-30T08:23:40.946840+00:00",
      "updated_at": "2026-09-30T08:23:40.946847+00:00"
    },
    {
      "id": "note-661ab931b362",
      "replay_time": "2026-06-08 10:54:00 EDT",
      "text": "達到全天波幅\n1. 10點後全天單邊找機會做多\n2. 突破失敗大TR全天TR或單邊震盪\n10點這段反轉走得很順1的可能性高一點",
      "created_at": "2026-09-30T08:26:50.728858+00:00",
      "updated_at": "2026-09-30T08:26:50.728866+00:00"
    },
    {
      "id": "note-5a45b86f8b3b",
      "replay_time": "2026-06-08 11:04:00 EDT",
      "text": "這邊確認突破成功，嘗試BOP Buy limit賭今天全天單邊",
      "created_at": "2026-09-30T08:27:32.985587+00:00",
      "updated_at": "2026-09-30T08:27:32.985595+00:00"
    },
    {
      "id": "note-26511008cdbe",
      "replay_time": "2026-06-08 11:34:00 EDT",
      "text": "實體Bear bar BO，如果有FT離場不然可以拿大TR 1R",
      "created_at": "2026-09-30T08:29:10.566483+00:00",
      "updated_at": "2026-09-30T08:29:10.566491+00:00"
    },
    {
      "id": "note-7368d85edb1d",
      "replay_time": "2026-06-08 11:44:00 EDT",
      "text": "強SB BOTA加倉，改守PB低點",
      "created_at": "2026-09-30T08:30:53.153245+00:00",
      "updated_at": "2026-09-30T08:30:53.153254+00:00"
    },
    {
      "id": "note-1b45a9457d94",
      "replay_time": "2026-06-08 12:24:00 EDT",
      "text": "這邊連續兩次嘗試測前高失敗，可能進入TTR\n或三角收斂等BO\n1. 直接離場兩倉BE，根原本預期不同\n2. 守SL\n這邊選擇1，因為有嘗試突破收陰線 + 12點附近可能FBO Reversal",
      "created_at": "2026-09-30T08:33:44.662296+00:00",
      "updated_at": "2026-09-30T08:34:36.765544+00:00"
    },
    {
      "id": "note-e7cd753014a2",
      "replay_time": "2026-06-08 12:44:00 EDT",
      "text": "空方拿到Actual risk 1R、整段50%附近\n看是上半區震盪還是會嘗試向下BO",
      "created_at": "2026-09-30T08:36:10.757332+00:00",
      "updated_at": "2026-09-30T08:36:10.757342+00:00"
    },
    {
      "id": "note-73555303a3e1",
      "replay_time": "2026-06-08 13:19:00 EDT",
      "text": "空方拿到Actual risk 2R 進入TTR\n這邊上下BO Confirm bar都可以嘗試",
      "created_at": "2026-09-30T08:37:33.355326+00:00",
      "updated_at": "2026-09-30T08:38:02.738162+00:00"
    },
    {
      "id": "note-b742e53d2ee1",
      "replay_time": "2026-06-08 13:29:00 EDT",
      "text": "BO bar太大沒辦法做",
      "created_at": "2026-09-30T08:39:17.313104+00:00",
      "updated_at": "2026-09-30T08:39:17.313114+00:00"
    },
    {
      "id": "note-570efbed5e42",
      "replay_time": "2026-06-08 13:34:00 EDT",
      "text": "多方拿到TTR BO 1R",
      "created_at": "2026-09-30T08:39:48.708475+00:00",
